y\" href=\"https://chat.whatsapp.com/LlSf99E2niNATpJlFxNskL\" target=\"_blank\" rel=\"noopener\">\n      <span class=\"contact-action-icon\" aria-hidden=\"true\">W</span>\n      <span><strong>WhatsApp</strong><small>Rejoindre le groupe</small></span>\n    </a>\n  </div>\n</section>\n\n<figure class=\"contact-photo\">\n  <img src=\"/assets/media/2025/12/img_3699.jpeg\" alt=\"Céline Lavis et Michael Peyrin, membres du bureau de l’association 200 à la ronde\" loading=\"lazy\" decoding=\"async\">\n  <figcaption>De droite à gauche : Céline L. (@chula) et Michael P. (@Mitch).</figcaption>\n</figure>",
